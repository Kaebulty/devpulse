# Python-generated files
__pycache__/
*.py[oc]
*.py[cod]
build/
dist/
wheels/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info

# Virtual environments
.venv

# Secrets — never commit real credentials or keys.
# The negation must follow .env.* or the template itself would be ignored.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# Django
*.sqlite3
staticfiles/

# Tailwind CLI: downloaded standalone binary (platform-specific, not committed) and
# its compiled output (a build artifact of tailwind/input.css, the real source).
/.bin/
services/django_core/apps/dashboard/static/dashboard/css/output.css

# IDEs / OS
.idea/
.vscode/
*.swp
.DS_Store
