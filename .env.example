# Original .env yet to be created

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
# Comma-separated hostnames, e.g. devpulse.example.com,localhost. Required once
# DJANGO_DEBUG=False (see settings.py) — leave empty for local dev.
DJANGO_ALLOWED_HOSTS=

# Database (matches compose.yaml)
# Generate every password below — see README "Local database". Never commit a filled-in .env.
POSTGRES_USER=devpulse_user
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Database names. core_db is created by the container via POSTGRES_DB;
# services_db by docker/init-databases.sh on first init.
CORE_DB_NAME=core_db
SERVICES_DB_NAME=services_db

# Per-service least-privilege roles, created by docker/init-databases.sh.
# django_user owns core_db, fastapi_user owns services_db, neither can reach the other.
DJANGO_DB_USER=django_user
DJANGO_DB_PASSWORD=change-me
FASTAPI_DB_USER=fastapi_user
FASTAPI_DB_PASSWORD=change-me

# Internal service auth (the X-Internal-Secret from the trust boundary)
INTERNAL_SECRET_TOKEN=change-me
